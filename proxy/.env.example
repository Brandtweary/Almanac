# Internal services are configured explicitly; no cloud fallback exists.
HOST=127.0.0.1
PORT=8790
LLM_BASE=http://127.0.0.1:8081
CONTENT_BASE=http://127.0.0.1:8791
SEARXNG_BASE=http://127.0.0.1:8888
EMBED_BASE=http://127.0.0.1:8899
# HTTP transcription service base and full backend speech WebSocket URL.
STT_BASE=http://127.0.0.1:8000
VOICE_TTS_BASE=ws://127.0.0.1:8793/api/tts_streaming
RELEASE_PROFILE=
FRONTEND_DIR=../dist
GATEWAY_LOG=./gateway.jsonl
ALLOWED_ORIGIN=http://localhost:8790,http://127.0.0.1:8790
# Socket peers allowed to name the real client in X-Forwarded-For for per-client
# rate limits. Defaults to loopback, which covers a TLS terminator on this host.
TRUSTED_PROXIES=127.0.0.1,::1
# Direct candidate evaluation requires a loopback bind. /ready stays 503.
QUALIFICATION_MODE=0
